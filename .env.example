# Database — PostgreSQL.
#   Local dev:  run `docker compose up -d` and use the local URL below.
#   Production: create a Postgres store (Vercel Postgres / Neon / Supabase) and
#               set both vars in the Vercel dashboard.
#     DATABASE_URL = pooled connection string (used at runtime)
#     DIRECT_URL   = direct / non-pooled connection (used for migrations)
#   (Non-pooled providers can use the same value for both.)
DATABASE_URL="postgresql://tavola:tavola@localhost:5432/tavola?schema=public"
DIRECT_URL="postgresql://tavola:tavola@localhost:5432/tavola?schema=public"

# Secret used to sign session cookies (and password hashes are PBKDF2). Set a
# long random value for any real deployment (e.g. `openssl rand -hex 32`).
# Admins/owners are user accounts — sign up at /admin/signup (the seed creates a
# demo account: demo@tavola.app / tavola).
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Asset storage (uploaded GLB / images / generated USDZ). On Vercel, create a
# Blob store (Storage → Blob) — it sets BLOB_READ_WRITE_TOKEN automatically.
# Leave unset locally to write files into /public instead.
BLOB_READ_WRITE_TOKEN=""

# Set to "true" on Vercel (alongside the Blob store) so the admin uploads go
# DIRECTLY to Blob from the browser — bypasses the ~4.5 MB serverless body limit
# for large models. Leave unset locally.
NEXT_PUBLIC_BLOB_ENABLED=""

# Absolute site origin used for sitemap.xml / robots.txt URLs. Set this in
# production (e.g. https://tavola.vercel.app). Optional locally.
NEXT_PUBLIC_SITE_URL=""
