// Tavola — true-to-scale AR dish preview for restaurant menus
// Prisma schema. PostgreSQL (works on Vercel / Neon / any Postgres).
//   DATABASE_URL — runtime connection (use the POOLED url on serverless)
//   DIRECT_URL   — direct (non-pooled) url used for migrations
// For local dev, both can point at the same local Postgres (see docker-compose).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Platform user. Owners manage their own restaurants; ADMINs see everything.
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  role         UserRole     @default(OWNER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  restaurants  Restaurant[]
  memberships  Membership[]
}

enum UserRole {
  ADMIN
  OWNER
}

// A user invited to co-manage a restaurant they don't own.
model Membership {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId])
}

model Restaurant {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique // used for the public menu at /r/[slug]
  logoUrl    String?
  brandColor String? // hex, e.g. "#0F766E" — used for light per-restaurant theming
  currency   String     @default("EUR")
  defaultLocale String? // initial menu language when the guest hasn't picked one
  // Optional contact details, shown in the public menu footer.
  address    String?
  phone      String?
  website    String?
  ownerId    String? // the User who owns this restaurant
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  memberships Membership[]
  categories  Category[]
  dishes      Dish[]

  @@index([ownerId])
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  description  String? // optional editorial line shown under the heading
  sortOrder    Int        @default(0)
  // { [locale]: { name, description } } — localized category content
  translations Json?

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes       Dish[]

  @@index([restaurantId])
}

model Dish {
  id           String      @id @default(cuid())
  restaurantId String
  categoryId   String?
  name         String
  description  String?
  // { [locale]: { name, description } } — localized dish content
  translations Json?
  price        Float       @default(0)

  // 3D / AR assets. glbUrl drives the in-browser viewer + Android Scene Viewer.
  // usdzUrl is required for iOS Quick Look; null => iOS AR gracefully disabled.
  glbUrl       String
  usdzUrl      String?
  thumbnailUrl String?

  // Real-world portion info — the hero value of Tavola (portion transparency).
  // These are the operator-STATED real dimensions (editorial).
  widthCm      Float?
  depthCm      Float?
  heightCm     Float?
  weightG      Int?
  serves       String? // e.g. "1-2"
  allergens    String? // comma-separated list, e.g. "gluten,shellfish"
  calories     Int? // kcal per portion (UK out-of-home calorie labelling)
  dietary      String? // comma-separated tags, e.g. "vegetarian,gluten-free"

  // MEASURED bounding box of the GLB in cm (authored at 1 unit = 1 m). Captured
  // in admin via model-viewer.getDimensions(). When these agree with the stated
  // dimensions, the dish is genuinely true-to-scale → "Verified to scale" badge.
  modelWidthCm  Float?
  modelDepthCm  Float?
  modelHeightCm Float?

  featured     Boolean     @default(false)
  // Operator can "86" a dish (temporarily out of stock) without deleting it.
  available    Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  arViews      ArView[]
  views        DishView[]
  feedback     DishFeedback[]

  @@index([restaurantId])
  @@index([categoryId])
}

// Lightweight analytics: one row per AR launch.
model ArView {
  id        String   @id @default(cuid())
  dishId    String
  createdAt DateTime @default(now())

  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId])
}

// One row per dish-detail view — the top of the "view → AR launch" funnel.
model DishView {
  id        String   @id @default(cuid())
  dishId    String
  createdAt DateTime @default(now())

  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId])
}

// Guest answer to "does this portion look like what you expected?" — the
// first-party outcome signal (which dishes' marketing oversells the portion).
model DishFeedback {
  id        String   @id @default(cuid())
  dishId    String
  verdict   String // "smaller" | "as_expected" | "bigger"
  createdAt DateTime @default(now())

  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId])
}
